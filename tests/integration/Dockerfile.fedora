# Throwaway Fedora machine for envira integration runs: a normal user with passwordless sudo and
# no unzip (envira installs it as a dependency). The image's curl-minimal is enough.
FROM fedora:44

RUN dnf install -y --setopt=install_weak_deps=False sudo zsh python3 ca-certificates findutils procps-ng \
 && dnf clean all

RUN useradd -m -s /bin/zsh user \
 && echo "user ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/user \
 && touch /home/user/.zshrc && chown user:user /home/user/.zshrc

USER user
WORKDIR /home/user
